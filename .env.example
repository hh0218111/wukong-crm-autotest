# 复制本文件为 .env 并改成你自己的环境值（.env 不会被提交到 git）
# 悟空CRM：后端 API 入口（前端是独立 SPA，路径为 index.html#/login）
BASE_URL=http://localhost/72crm/index.php
CRM_ADMIN_USER=<your_crm_admin_username>
CRM_ADMIN_PASS=<your_crm_admin_password>

# 数据库配置（造数据/核对数据用，utils/db.py）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=<your_db_password>
DB_NAME=5kcrm
DB_PREFIX=5kcrm_
